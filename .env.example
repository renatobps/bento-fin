# WhatsApp / Evolution GO
# OBRIGATÓRIO
WHATSAPP_API_URL=https://evogo.arkcoredev.com
# OBRIGATÓRIO — token da instância (header apikey); NÃO é a chave global do servidor
WHATSAPP_API_KEY=token-da-instancia
# OBRIGATÓRIO — usado para filtrar eventos do webhook pelo campo "instance"
WHATSAPP_INSTANCE_NAME=botml
# Opcional
LOJA_WHATSAPP="5561996690313"
# Opcional — o Evolution GO não envia o header apikey, então inclua ?apikey= na URL
WHATSAPP_WEBHOOK_URL=https://arkcoredev-webhook.ultrahook.com?apikey=segredo-do-webhook
# RECOMENDADO em produção — token exclusivo do webhook, diferente da WHATSAPP_API_KEY.
# Como ele trafega na query string (e vaza em log de proxy), separá-lo evita que um
# vazamento entregue também o controle da instância do WhatsApp.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use o mesmo valor no ?apikey= da WHATSAPP_WEBHOOK_URL. Sem ele, cai na WHATSAPP_API_KEY.
WEBHOOK_SECRET=

# IA
# OBRIGATÓRIO
ANTHROPIC_API_KEY=
# Opcional — sem ela, transcrição de áudio fica desativada
OPENAI_API_KEY=

# Banco de dados
# OBRIGATÓRIO
DATABASE_URL=postgresql://user:pass@localhost:5432/bento

# Servidor
# Opcional
PORT=3000
# OBRIGATÓRIO — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Opcional
CORS_ORIGIN=http://localhost:3001,http://192.168.1.9:3001

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ESSENCIAL_MONTHLY=price_...
STRIPE_PRICE_ESSENCIAL_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# URLs
FRONTEND_URL=http://localhost:3001
LANDING_URL=http://localhost:3001

# Custo de IA (painel admin)
USD_TO_BRL_RATE=5.00
CLAUDE_HAIKU_INPUT_COST_PER_MTK=1.00
CLAUDE_HAIKU_OUTPUT_COST_PER_MTK=5.00

# Admin
ADMIN_SESSION_DURATION_HOURS=8

# Suporte
SUPPORT_EMAIL=suporte@bento.com.br

# Dashboard Next.js (copiar para dashboard/.env.local)
NEXT_PUBLIC_CRISP_WEBSITE_ID=seu-website-id-aqui
NEXT_PUBLIC_SUPPORT_EMAIL=suporte@bento.com.br
NEXT_PUBLIC_WHATSAPP_NUMBER=5561996690313
